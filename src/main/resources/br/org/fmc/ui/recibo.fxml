<?xml version="1.0" encoding="UTF-8"?>

<!--
  BOARD-60 · Janela do recibo, no desenho do protótipo: as duas vias (Locatário e Fundação)
  e os botões Salvar PDF e Imprimir. Abre sozinha depois de receber um aluguel e também
  pelo número do recibo na tabela de Aluguéis. As vias são montadas no ReciboController.
-->

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<StackPane fx:id="veu" styleClass="veu" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
           fx:controller="br.org.fmc.ui.ReciboController">
    <VBox styleClass="janela" maxWidth="900" maxHeight="-Infinity">
        <StackPane.margin><Insets top="28" right="28" bottom="28" left="28"/></StackPane.margin>
        <HBox styleClass="janela-topo" spacing="16" alignment="TOP_LEFT">
            <VBox spacing="5" HBox.hgrow="ALWAYS">
                <Label fx:id="titulo" styleClass="janela-titulo"/>
                <Label fx:id="subtitulo" styleClass="janela-sub" wrapText="true" minHeight="-Infinity"/>
            </VBox>
            <Button onAction="#fechar" styleClass="botao-icone" accessibleText="Fechar">
                <graphic><FontIcon iconLiteral="fth-x"/></graphic>
            </Button>
        </HBox>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="rolagem" VBox.vgrow="ALWAYS">
            <content>
                <VBox styleClass="janela-corpo" spacing="12">
                    <HBox fx:id="avisoSucesso" styleClass="resumo-calculado" spacing="10" alignment="CENTER_LEFT">
                        <FontIcon iconLiteral="fth-check-circle"/>
                        <Label fx:id="textoSucesso" wrapText="true" minHeight="-Infinity" HBox.hgrow="ALWAYS"/>
                    </HBox>
                    <HBox fx:id="avisoErros" styleClass="aviso-erro" spacing="10">
                        <FontIcon iconLiteral="fth-alert-circle"/>
                        <Label fx:id="textoErros" wrapText="true" minHeight="-Infinity" HBox.hgrow="ALWAYS"/>
                    </HBox>
                    <VBox fx:id="vias" styleClass="recibo-folha" spacing="18"/>
                </VBox>
            </content>
        </ScrollPane>
        <HBox styleClass="janela-rodape" spacing="12" alignment="CENTER_RIGHT">
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Fechar" onAction="#fechar" styleClass="botao-secundario"/>
            <Button text="Salvar PDF" onAction="#salvarPdf" styleClass="botao-secundario">
                <graphic><FontIcon iconLiteral="fth-download"/></graphic>
            </Button>
            <Button text="Imprimir" onAction="#imprimir" styleClass="botao-primario" defaultButton="true">
                <graphic><FontIcon iconLiteral="fth-printer"/></graphic>
            </Button>
        </HBox>
    </VBox>
</StackPane>
