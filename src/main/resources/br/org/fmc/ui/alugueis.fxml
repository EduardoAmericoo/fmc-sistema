<?xml version="1.0" encoding="UTF-8"?>

<!--
  BOARD-38 · Tela "Aluguéis": os aluguéis do mês e a situação de cada um.
  Segue o modelo das outras telas e a tela "Aluguéis e cobrança" do design system:
  1. cabeçalho com o título e o resumo do mês;
  2. filtros: mês e busca (imóvel, inquilino ou contrato);
  3. cartão com abas por situação (com a contagem de cada uma) e a tabela.
  Os aluguéis do mês são gerados sozinhos ao entrar no sistema (BOARD-37, sem botão);
  o "Receber" da linha é da BOARD-39.
-->

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<StackPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
           fx:controller="br.org.fmc.ui.AlugueisController">

    <VBox styleClass="conteudo" spacing="24">
        <HBox fx:id="cabecalho" alignment="BOTTOM_LEFT" spacing="24">
            <VBox spacing="6" HBox.hgrow="ALWAYS">
                <Label text="Aluguéis e cobrança" styleClass="titulo"/>
                <Label fx:id="contagem" styleClass="texto"/>
            </VBox>
        </HBox>

        <HBox fx:id="abasVisualizacao" styleClass="abas" spacing="4">
            <fx:define><ToggleGroup fx:id="grupoVisualizacao"/></fx:define>
            <ToggleButton fx:id="abaAlugueis" text="Aluguéis" toggleGroup="$grupoVisualizacao" styleClass="aba"/>
            <ToggleButton fx:id="abaCobranca" text="Para cobrança" toggleGroup="$grupoVisualizacao" styleClass="aba"/>
        </HBox>

        <HBox fx:id="barraFiltrosMes" spacing="12" alignment="CENTER_LEFT">
            <!-- Seletor de mês: ‹ Novembro de 2026 › (o nome abre a lista de meses) -->
            <HBox styleClass="seletor-mes" alignment="CENTER">
                <Button fx:id="mesAnterior" onAction="#irMesAnterior" styleClass="seta-mes"
                        accessibleText="Mês anterior">
                    <graphic><FontIcon iconLiteral="fth-chevron-left"/></graphic>
                </Button>
                <ComboBox fx:id="campoMes" prefWidth="215" styleClass="nome-mes" accessibleText="Mês dos aluguéis"/>
                <Button fx:id="mesSeguinte" onAction="#irMesSeguinte" styleClass="seta-mes"
                        accessibleText="Mês seguinte">
                    <graphic><FontIcon iconLiteral="fth-chevron-right"/></graphic>
                </Button>
            </HBox>
            <Button text="Mês atual" onAction="#irMesAtual" styleClass="botao-secundario"/>
            <TextField fx:id="campoBusca" promptText="Buscar por imóvel, inquilino ou contrato" HBox.hgrow="ALWAYS"
                       accessibleText="Buscar aluguel"/>
            <Button text="Limpar filtros" onAction="#limparFiltros"/>
        </HBox>

        <VBox fx:id="resumoMes" styleClass="cartao-resumo" spacing="14">
            <VBox spacing="4" styleClass="bloco-resumo-mes">
                <Label fx:id="tituloResumoMes" styleClass="subtitulo"/>
                <Label fx:id="textoResumoMes" styleClass="texto" wrapText="true"/>
            </VBox>
            <HBox fx:id="barraSituacoes" styleClass="barra-situacoes" spacing="4">
                <Region fx:id="barraPagos" styleClass="barra-status-pago"/>
                <Region fx:id="barraAVencer" styleClass="barra-status-vencer"/>
                <Region fx:id="barraTolerancia" styleClass="barra-status-tolerancia"/>
                <Region fx:id="barraAtraso" styleClass="barra-status-atraso"/>
            </HBox>
            <HBox spacing="28" styleClass="resumo-status">
                <VBox spacing="2"><Label text="Pagos"/><Label fx:id="quantidadePagos" styleClass="numero-resumo"/><Label fx:id="valorPagos"/></VBox>
                <VBox spacing="2"><Label text="A vencer"/><Label fx:id="quantidadeAVencer" styleClass="numero-resumo"/><Label fx:id="valorAVencer"/></VBox>
                <VBox spacing="2"><Label text="Em tolerância"/><Label fx:id="quantidadeTolerancia" styleClass="numero-resumo"/><Label fx:id="valorTolerancia"/></VBox>
                <VBox spacing="2"><Label text="Em atraso"/><Label fx:id="quantidadeAtraso" styleClass="numero-resumo"/><Label fx:id="valorAtraso"/></VBox>
            </HBox>
        </VBox>

        <VBox fx:id="resumoCobranca" styleClass="cartao-resumo" spacing="10" managed="false" visible="false">
            <VBox spacing="4">
                <Label text="Meses em aberto" styleClass="subtitulo"/>
                <Label text="Cobrança a partir de mais de 1 mês em aberto · valores atualizados com multa, juros e INPC"
                       styleClass="texto" wrapText="true"/>
                <HBox spacing="28" styleClass="resumo-calculado">
                    <VBox spacing="3"><Label fx:id="contagemDoisMeses" text="2 meses"/><Label fx:id="valorDoisMeses"/></VBox>
                    <VBox spacing="3"><Label fx:id="contagemTresMeses" text="3 meses"/><Label fx:id="valorTresMeses"/></VBox>
                    <VBox spacing="3"><Label fx:id="contagemQuatroMeses" text="4 ou mais"/><Label fx:id="valorQuatroMeses"/></VBox>
                </HBox>
            </VBox>
        </VBox>

        <VBox styleClass="cartao-tabela" VBox.vgrow="ALWAYS">
            <HBox fx:id="abas" styleClass="abas" spacing="4">
                <fx:define><ToggleGroup fx:id="grupoSituacao"/></fx:define>
                <ToggleButton fx:id="abaAtraso" toggleGroup="$grupoSituacao" styleClass="aba"/>
                <ToggleButton fx:id="abaTolerancia" toggleGroup="$grupoSituacao" styleClass="aba"/>
                <ToggleButton fx:id="abaAVencer" toggleGroup="$grupoSituacao" styleClass="aba"/>
                <ToggleButton fx:id="abaPagos" toggleGroup="$grupoSituacao" styleClass="aba"/>
                <ToggleButton fx:id="abaTodos" toggleGroup="$grupoSituacao" styleClass="aba"/>
            </HBox>
            <TableView fx:id="tabela" styleClass="tabela-fmc" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colunaInquilino" text="Inquilino e imóvel" prefWidth="290" minWidth="200"/>
                    <TableColumn fx:id="colunaContrato" text="Contrato" prefWidth="110" minWidth="100"/>
                    <TableColumn fx:id="colunaVencimento" text="Vencimento" prefWidth="170" minWidth="150"/>
                    <TableColumn fx:id="colunaValor" text="Valor do mês" prefWidth="140" minWidth="130"
                                 styleClass="coluna-numero"/>
                    <TableColumn fx:id="colunaSituacao" text="Situação" prefWidth="150" minWidth="140"/>
                    <TableColumn fx:id="colunaDemonstrativo" text="Recibo / ações" prefWidth="210" minWidth="190"
                                 sortable="false"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
                </columnResizePolicy>
            </TableView>
                <!-- Inquilinos com dois ou mais aluguéis vencidos, agrupados por contrato. -->
            <TableView fx:id="tabelaCobranca" styleClass="tabela-fmc" VBox.vgrow="ALWAYS"
                       managed="false" visible="false">
                <columns>
                    <TableColumn fx:id="cobrancaInquilino" text="Inquilino e imóvel" prefWidth="180" minWidth="160"/>
                    <TableColumn fx:id="cobrancaMeses" text="Em aberto" prefWidth="95" minWidth="85"/>
                    <TableColumn fx:id="cobrancaOriginal" text="Valor original" prefWidth="125" minWidth="120"
                                 styleClass="coluna-numero"/>
                    <TableColumn fx:id="cobrancaAtualizado" text="Valor atualizado" prefWidth="135" minWidth="130"
                                 styleClass="coluna-numero"/>
                    <TableColumn fx:id="cobrancaFiador" text="Fiador" prefWidth="140" minWidth="115"/>
                    <TableColumn fx:id="cobrancaUltimoContato" text="Contato" prefWidth="165" minWidth="150"/>
                    <TableColumn fx:id="cobrancaAcao" prefWidth="125" minWidth="125" sortable="false"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
                </columnResizePolicy>
            </TableView>
        </VBox>
    </VBox>
</StackPane>
