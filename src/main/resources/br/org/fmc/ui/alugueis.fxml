<?xml version="1.0" encoding="UTF-8"?>

<!--
  BOARD-38 · Tela "Aluguéis": os aluguéis do mês e a situação de cada um.
  Segue o modelo das outras telas e a tela "Aluguéis e cobrança" do design system:
  1. cabeçalho com o título e o resumo do mês;
  2. filtros: mês e busca (imóvel, inquilino ou contrato);
  3. cartão com abas por situação (com a contagem de cada uma) e a tabela.
  O botão "Gerar aluguéis do mês" é da BOARD-37 e o "Receber" é da BOARD-39:
  os lugares deles estão marcados abaixo.
-->

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<StackPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
           fx:controller="br.org.fmc.ui.AlugueisController">

    <VBox styleClass="conteudo" spacing="24">
        <HBox fx:id="cabecalho" alignment="BOTTOM_LEFT" spacing="24">
            <VBox spacing="6" HBox.hgrow="ALWAYS">
                <Label text="Aluguéis" styleClass="titulo"/>
                <Label fx:id="contagem" styleClass="texto"/>
            </VBox>
            <!-- BOARD-37: o botão "Gerar aluguéis do mês" entra aqui, à direita do título. -->
        </HBox>

        <HBox spacing="12" alignment="CENTER_LEFT">
            <ComboBox fx:id="campoMes" prefWidth="235" accessibleText="Mês dos aluguéis"/>
            <TextField fx:id="campoBusca" promptText="Buscar por imóvel, inquilino ou contrato" HBox.hgrow="ALWAYS"
                       accessibleText="Buscar aluguel"/>
            <Button text="Limpar filtros" onAction="#limparFiltros"/>
            <!-- [D6] BOARD-44: abre a lista de cobrança (uma linha por inquilino com 2 ou mais aluguéis atrasados) -->
            <Button fx:id="botaoCobranca" text="Lista de cobrança" onAction="#abrirCobranca" styleClass="botao-secundario">
                <graphic><FontIcon iconLiteral="fth-alert-triangle"/></graphic>
            </Button>
        </HBox>

        <!-- Faixa que aparece quando a tela vem do Painel com a lista de cobrança -->
        <HBox fx:id="faixaRecorte" styleClass="resumo-calculado" spacing="10" alignment="CENTER_LEFT"
              managed="false" visible="false">
            <FontIcon iconLiteral="fth-filter"/>
            <Label fx:id="textoRecorte" wrapText="true" minHeight="-Infinity" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
            <Button text="Ver todos os aluguéis" onAction="#verTodos" styleClass="botao-secundario, botao-pequeno"/>
        </HBox>

        <VBox styleClass="cartao-tabela" VBox.vgrow="ALWAYS">
            <HBox fx:id="abas" styleClass="abas" spacing="4">
                <fx:define><ToggleGroup fx:id="grupoSituacao"/></fx:define>
                <ToggleButton fx:id="abaAtraso" toggleGroup="$grupoSituacao" styleClass="aba"/>
                <ToggleButton fx:id="abaTolerancia" toggleGroup="$grupoSituacao" styleClass="aba"/>
                <ToggleButton fx:id="abaAVencer" toggleGroup="$grupoSituacao" styleClass="aba"/>
                <ToggleButton fx:id="abaPagos" toggleGroup="$grupoSituacao" styleClass="aba"/>
                <ToggleButton fx:id="abaTodos" toggleGroup="$grupoSituacao" styleClass="aba"/>
            </HBox>
            <TableView fx:id="tabela" styleClass="tabela-fmc" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colunaInquilino" text="Inquilino e imóvel" prefWidth="320" minWidth="200"/>
                    <TableColumn fx:id="colunaContrato" text="Contrato" prefWidth="110" minWidth="100"/>
                    <TableColumn fx:id="colunaVencimento" text="Vencimento" prefWidth="170" minWidth="150"/>
                    <TableColumn fx:id="colunaValor" text="Valor do mês" prefWidth="140" minWidth="130"
                                 styleClass="coluna-numero"/>
                    <TableColumn fx:id="colunaSituacao" text="Situação" prefWidth="150" minWidth="140"/>
                    <!-- BOARD-39: a coluna com o botão "Receber" entra aqui. -->
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
                </columnResizePolicy>
            </TableView>
            <!-- Lista de cobrança (vinda do Painel): uma linha por inquilino, no lugar das abas e da tabela acima -->
            <TableView fx:id="tabelaCobranca" styleClass="tabela-fmc" VBox.vgrow="ALWAYS"
                       managed="false" visible="false">
                <columns>
                    <TableColumn fx:id="cobrancaInquilino" text="Inquilino e imóvel" prefWidth="225" minWidth="200"/>
                    <TableColumn fx:id="cobrancaAtrasados" text="Atrasados" prefWidth="125" minWidth="115"/>
                    <TableColumn fx:id="cobrancaMaisAntigo" text="Mais antigo" prefWidth="155" minWidth="150"/>
                    <TableColumn fx:id="cobrancaGarantia" text="Fiador ou caução" prefWidth="180" minWidth="160"/>
                    <TableColumn fx:id="cobrancaDevido" text="Deve hoje" prefWidth="170" minWidth="160"
                                 styleClass="coluna-numero"/>
                    <TableColumn fx:id="cobrancaAcao" prefWidth="60" minWidth="60" maxWidth="60" sortable="false"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
                </columnResizePolicy>
            </TableView>
        </VBox>
    </VBox>
</StackPane>
