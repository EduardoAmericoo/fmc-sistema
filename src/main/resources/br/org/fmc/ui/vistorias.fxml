<?xml version="1.0" encoding="UTF-8"?>

<!--
  Vistorias com fotos (revisão da SR2): as fotos do imóvel na entrega das chaves (entrada) e na
  devolução (saída), por cômodo, e a comparação lado a lado. O conteúdo de cada aba é montado
  no VistoriasController.
-->

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<StackPane fx:id="veu" styleClass="veu" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
           fx:controller="br.org.fmc.ui.VistoriasController">
    <fx:define>
        <ToggleGroup fx:id="grupoAbas"/>
    </fx:define>
    <VBox styleClass="janela" maxWidth="1180" maxHeight="-Infinity">
        <StackPane.margin><Insets top="24" right="24" bottom="24" left="24"/></StackPane.margin>
        <HBox styleClass="janela-topo" spacing="16" alignment="TOP_LEFT">
            <VBox spacing="5" HBox.hgrow="ALWAYS">
                <Label fx:id="titulo" text="Vistorias" styleClass="janela-titulo"/>
                <Label fx:id="subtitulo" styleClass="janela-sub" wrapText="true" minHeight="-Infinity"/>
            </VBox>
            <Button onAction="#fechar" styleClass="botao-icone" accessibleText="Fechar">
                <graphic><FontIcon iconLiteral="fth-x"/></graphic>
            </Button>
        </HBox>
        <HBox styleClass="abas" spacing="4">
            <padding><Insets left="24" right="24"/></padding>
            <ToggleButton fx:id="abaEntrada" text="Entrada" toggleGroup="$grupoAbas" styleClass="aba" selected="true"/>
            <ToggleButton fx:id="abaSaida" text="Saída" toggleGroup="$grupoAbas" styleClass="aba"/>
            <ToggleButton fx:id="abaComparar" text="Comparar entrada e saída" toggleGroup="$grupoAbas" styleClass="aba"/>
        </HBox>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="rolagem" prefHeight="620" VBox.vgrow="ALWAYS">
            <VBox fx:id="conteudo" styleClass="janela-corpo" spacing="14"/>
        </ScrollPane>
        <HBox styleClass="janela-rodape" spacing="12" alignment="CENTER_RIGHT">
            <Label fx:id="dicaLacre" styleClass="dica" wrapText="true" HBox.hgrow="ALWAYS" maxWidth="Infinity"
                   text="Cada foto tem um lacre: se o arquivo for editado depois do registro, ele deixa de conferir."/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="botaoLaudo" text="Gerar laudo (PDF)" onAction="#gerarLaudo" styleClass="botao-secundario"
                    minWidth="-Infinity">
                <graphic><FontIcon iconLiteral="fth-file-text"/></graphic>
            </Button>
            <Button text="Fechar" onAction="#fechar" styleClass="botao-primario" minWidth="-Infinity"/>
        </HBox>
    </VBox>
</StackPane>
