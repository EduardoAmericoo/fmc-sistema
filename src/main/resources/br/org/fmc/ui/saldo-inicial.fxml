<?xml version="1.0" encoding="UTF-8"?>

<!--
  [D5] BOARD-63 · Saldo inicial do Caixa e do Banco: o Administrador informa uma vez quanto
  havia em cada um na data. Daí em diante o sistema soma os recebimentos sozinho.
-->

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<StackPane fx:id="veu" styleClass="veu" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
           fx:controller="br.org.fmc.ui.SaldoInicialController">
    <VBox styleClass="janela" maxWidth="560" maxHeight="-Infinity">
        <StackPane.margin><Insets top="32" right="32" bottom="32" left="32"/></StackPane.margin>
        <HBox styleClass="janela-topo" spacing="16" alignment="TOP_LEFT">
            <VBox spacing="5" HBox.hgrow="ALWAYS">
                <Label text="Informar saldo inicial" styleClass="janela-titulo"/>
                <Label text="Quanto havia no Caixa e no Banco na data. Só é informado uma vez."
                       styleClass="janela-sub" wrapText="true" minHeight="-Infinity"/>
            </VBox>
            <Button onAction="#fechar" styleClass="botao-icone" accessibleText="Fechar">
                <graphic><FontIcon iconLiteral="fth-x"/></graphic>
            </Button>
        </HBox>
        <VBox styleClass="janela-corpo" spacing="8">
            <HBox fx:id="avisoErros" styleClass="aviso-erro" spacing="10">
                <FontIcon iconLiteral="fth-alert-circle"/>
                <Label fx:id="textoErros" wrapText="true" minHeight="-Infinity" HBox.hgrow="ALWAYS"/>
            </HBox>
            <Label text="Data do saldo *" labelFor="$campoData" styleClass="rotulo"/>
            <DatePicker fx:id="campoData" prefWidth="200" styleClass="campo" promptText="dd/mm/aaaa"/>
            <Label text="Use o saldo do extrato do banco e a contagem do caixa nesse dia, antes dos recebimentos do dia."
                   styleClass="dica" wrapText="true" minHeight="-Infinity"/>

            <Label text="Saldo do Caixa (dinheiro e cheque)" labelFor="$campoCaixa" styleClass="rotulo">
                <VBox.margin><Insets top="10"/></VBox.margin>
            </Label>
            <TextField fx:id="campoCaixa" styleClass="campo" promptText="0,00"/>
            <Label fx:id="jaCaixa" styleClass="dica" wrapText="true" minHeight="-Infinity"/>

            <Label text="Saldo do Banco (total das contas)" labelFor="$campoBanco" styleClass="rotulo">
                <VBox.margin><Insets top="10"/></VBox.margin>
            </Label>
            <TextField fx:id="campoBanco" styleClass="campo" promptText="0,00"/>
            <Label fx:id="jaBanco" styleClass="dica" wrapText="true" minHeight="-Infinity"/>

            <HBox styleClass="resumo-calculado" spacing="10" alignment="TOP_LEFT">
                <VBox.margin><Insets top="10"/></VBox.margin>
                <FontIcon iconLiteral="fth-info"/>
                <Label wrapText="true" minHeight="-Infinity" HBox.hgrow="ALWAYS"
                       text="Depois de salvo, o saldo não muda à mão: cada recibo soma sozinho no Caixa ou no Banco. Deixe em branco a conta que quiser informar depois."/>
            </HBox>
        </VBox>
        <HBox styleClass="janela-rodape" spacing="12" alignment="CENTER_RIGHT">
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Cancelar" onAction="#fechar" styleClass="botao-secundario"/>
            <Button text="Salvar saldo inicial" onAction="#salvar" styleClass="botao-primario" defaultButton="true">
                <graphic><FontIcon iconLiteral="fth-check"/></graphic>
            </Button>
        </HBox>
    </VBox>
</StackPane>
