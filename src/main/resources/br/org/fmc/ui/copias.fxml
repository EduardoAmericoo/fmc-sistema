<?xml version="1.0" encoding="UTF-8"?>

<!--
  Cópias de segurança (revisão da SR2): não perder os dados se o computador der problema.
  Mostra a última cópia, faz uma cópia na hora, salva uma cópia em pen drive e restaura uma cópia.
  A cópia automática do dia é feita ao fechar o sistema (App.stop).
-->

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<StackPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
           fx:controller="br.org.fmc.ui.CopiasController">
    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="rolagem">
        <VBox styleClass="conteudo" spacing="20">
            <VBox spacing="6">
                <Label text="Cópias de segurança" styleClass="titulo"/>
                <Label text="Os dados do sistema (o banco de dados e os documentos anexados aos contratos) ficam neste computador. As cópias protegem a Fundação se o computador estragar, for trocado ou se algo for apagado por engano."
                       styleClass="texto" wrapText="true" minHeight="-Infinity"/>
            </VBox>

            <HBox fx:id="situacao" styleClass="veredito" spacing="10" alignment="CENTER_LEFT">
                <FontIcon fx:id="iconeSituacao" iconLiteral="fth-check-circle"/>
                <Label fx:id="textoSituacao" wrapText="true" minHeight="-Infinity" HBox.hgrow="ALWAYS"/>
            </HBox>

            <GridPane hgap="16">
                <columnConstraints>
                    <ColumnConstraints percentWidth="33.3" hgrow="ALWAYS"/>
                    <ColumnConstraints percentWidth="33.3" hgrow="ALWAYS"/>
                    <ColumnConstraints percentWidth="33.3" hgrow="ALWAYS"/>
                </columnConstraints>
                <VBox styleClass="cartao-resumo, passo-importacao" spacing="10" maxWidth="Infinity" maxHeight="Infinity" GridPane.columnIndex="0">
                    <Label text="Todo dia, sozinha" styleClass="subtitulo"/>
                    <Label fx:id="textoAutomatica" styleClass="texto" wrapText="true" minHeight="-Infinity" VBox.vgrow="ALWAYS"/>
                </VBox>
                <VBox styleClass="cartao-resumo, passo-importacao" spacing="10" maxWidth="Infinity" maxHeight="Infinity" GridPane.columnIndex="1">
                    <Label text="Antes de uma mudança grande" styleClass="subtitulo"/>
                    <Label text="Antes de importar uma planilha ou fazer muitos cadastros, faça uma cópia na hora. Ela fica guardada até ser apagada."
                           styleClass="texto" wrapText="true" minHeight="-Infinity" VBox.vgrow="ALWAYS"/>
                    <Button fx:id="botaoFazer" text="Fazer cópia agora" onAction="#fazerAgora" styleClass="botao-primario" minWidth="-Infinity">
                        <graphic><FontIcon iconLiteral="fth-save"/></graphic>
                    </Button>
                </VBox>
                <VBox styleClass="cartao-resumo, passo-importacao" spacing="10" maxWidth="Infinity" maxHeight="Infinity" GridPane.columnIndex="2">
                    <Label text="Fora do computador" styleClass="subtitulo"/>
                    <Label text="Uma vez por semana, salve uma cópia completa (banco e documentos, num arquivo .zip) em um pen drive ou HD externo e guarde longe do computador. Se ele estragar, é essa cópia que salva os dados."
                           styleClass="texto" wrapText="true" minHeight="-Infinity" VBox.vgrow="ALWAYS"/>
                    <Button text="Salvar cópia em…" onAction="#salvarEm" styleClass="botao-secundario" minWidth="-Infinity">
                        <graphic><FontIcon iconLiteral="fth-hard-drive"/></graphic>
                    </Button>
                </VBox>
            </GridPane>

            <HBox fx:id="avisoOk" styleClass="veredito, veredito-ok" spacing="10" alignment="CENTER_LEFT">
                <FontIcon iconLiteral="fth-check-circle"/>
                <Label fx:id="textoOk" wrapText="true" minHeight="-Infinity" HBox.hgrow="ALWAYS"/>
            </HBox>

            <HBox fx:id="avisoErros" styleClass="aviso-erro" spacing="10">
                <FontIcon iconLiteral="fth-alert-circle"/>
                <Label fx:id="textoErros" wrapText="true" minHeight="-Infinity" HBox.hgrow="ALWAYS"/>
            </HBox>

            <VBox spacing="10">
                <HBox spacing="12" alignment="CENTER_LEFT">
                    <VBox spacing="2" HBox.hgrow="ALWAYS">
                        <Label text="Cópias guardadas neste computador" styleClass="subtitulo"/>
                        <Label fx:id="textoPasta" styleClass="texto" wrapText="true" minHeight="-Infinity"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="botaoRestaurarArquivo" text="Restaurar de um pen drive…" onAction="#restaurarDeArquivo"
                            styleClass="botao-secundario" minWidth="-Infinity">
                        <graphic><FontIcon iconLiteral="fth-rotate-ccw"/></graphic>
                    </Button>
                </HBox>
                <VBox styleClass="cartao-tabela">
                    <TableView fx:id="tabela" styleClass="tabela-fmc" prefHeight="360">
                        <columns>
                            <TableColumn fx:id="colunaQuando" text="Feita em" prefWidth="220" minWidth="180"/>
                            <TableColumn fx:id="colunaTipo" text="Tipo de cópia" prefWidth="260" minWidth="180"/>
                            <TableColumn fx:id="colunaTamanho" text="Tamanho" prefWidth="120" minWidth="90"/>
                            <TableColumn fx:id="colunaAcoes" text="" prefWidth="160" minWidth="140" sortable="false"/>
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
                        </columnResizePolicy>
                    </TableView>
                </VBox>
            </VBox>
        </VBox>
    </ScrollPane>
</StackPane>
