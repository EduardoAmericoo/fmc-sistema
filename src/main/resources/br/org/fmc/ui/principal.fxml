<?xml version="1.0" encoding="UTF-8"?>

<!--
  Janela principal: menu lateral à esquerda, tela escolhida no centro.
  Cada botão do menu tem userData = nome do arquivo .fxml da tela (ver ui/Navegador.java).
  Para criar uma tela nova, NÃO precisa mexer aqui: crie o .fxml com o nome certo.
  Os ícones são do pacote Feather (Ikonli): https://kordamp.org/ikonli/cheat-sheet-feather.html
-->

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane fx:id="raiz" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="br.org.fmc.ui.PrincipalController" styleClass="raiz">

    <left>
        <VBox styleClass="menu-lateral" spacing="20">
            <VBox spacing="2">
                <Label text="Fundação Manuel Cruz" styleClass="marca" wrapText="true"/>
                <Label text="Gestão de aluguéis" styleClass="marca-sub"/>
            </VBox>

            <!-- Menu em seções, como no protótipo: Operação (o dia a dia), Cadastros e Gestão.
                 A seção some sozinha quando a pessoa não pode abrir nenhuma tela dela. -->
            <VBox fx:id="menu" spacing="14">
                <VBox styleClass="secao" spacing="2">
                    <Label text="OPERAÇÃO" styleClass="secao-menu"/>
                    <Button text="Painel" userData="painel" onAction="#abrirTela" styleClass="item-menu" maxWidth="Infinity">
                        <graphic><FontIcon iconLiteral="fth-grid"/></graphic>
                    </Button>
                    <Button text="Aluguéis e cobrança" userData="alugueis" onAction="#abrirTela" styleClass="item-menu" maxWidth="Infinity">
                        <graphic><FontIcon iconLiteral="fth-dollar-sign"/></graphic>
                    </Button>
                    <Button text="Caixa e banco" userData="caixa-banco" onAction="#abrirTela" styleClass="item-menu" maxWidth="Infinity">
                        <graphic><FontIcon iconLiteral="fth-credit-card"/></graphic>
                    </Button>
                </VBox>
                <VBox styleClass="secao" spacing="2">
                    <Label text="CADASTROS" styleClass="secao-menu"/>
                    <Button text="Inquilinos" userData="inquilinos" onAction="#abrirTela" styleClass="item-menu" maxWidth="Infinity">
                        <graphic><FontIcon iconLiteral="fth-users"/></graphic>
                    </Button>
                    <Button text="Imóveis" userData="imoveis" onAction="#abrirTela" styleClass="item-menu" maxWidth="Infinity">
                        <graphic><FontIcon iconLiteral="fth-home"/></graphic>
                    </Button>
                    <Button text="Contratos" userData="contratos" onAction="#abrirTela" styleClass="item-menu" maxWidth="Infinity">
                        <graphic><FontIcon iconLiteral="fth-file-text"/></graphic>
                    </Button>
                </VBox>
                <VBox styleClass="secao" spacing="2">
                    <Label text="GESTÃO" styleClass="secao-menu"/>
                    <Button text="Usuários" userData="usuarios" onAction="#abrirTela" styleClass="item-menu" maxWidth="Infinity">
                        <graphic><FontIcon iconLiteral="fth-shield"/></graphic>
                    </Button>
                    <Button text="Importar planilha" userData="importar" onAction="#abrirTela" styleClass="item-menu" maxWidth="Infinity">
                        <graphic><FontIcon iconLiteral="fth-upload"/></graphic>
                    </Button>
                    <Button text="Cópias de segurança" userData="copias" onAction="#abrirTela" styleClass="item-menu" maxWidth="Infinity">
                        <graphic><FontIcon iconLiteral="fth-database"/></graphic>
                    </Button>
                </VBox>
            </VBox>

            <Region VBox.vgrow="ALWAYS"/>

            <!-- Quem está logado; passar o mouse mostra a situação do banco de dados -->
            <!-- Revisão de usabilidade (24/11): o nome e o perfil ficavam cortados ("Adminis…") ao lado
                 de dois ícones. Agora os botões, com nome, ficam numa linha embaixo. -->
            <VBox fx:id="cartaoUsuario" styleClass="cartao-usuario" spacing="6">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label fx:id="avatar" styleClass="avatar" minWidth="-Infinity"/>
                    <VBox spacing="2" HBox.hgrow="ALWAYS" minWidth="0">
                        <Label fx:id="usuarioNome" styleClass="usuario-nome" wrapText="true"/>
                        <Label fx:id="usuarioPerfil" styleClass="usuario-perfil"/>
                    </VBox>
                </HBox>
                <HBox spacing="4" alignment="CENTER_LEFT">
                    <Button text="Trocar senha" onAction="#trocarSenha" styleClass="botao-icone, botao-icone-texto"
                            accessibleText="Trocar minha senha">
                        <graphic><FontIcon iconLiteral="fth-key"/></graphic>
                        <tooltip><Tooltip text="Trocar minha senha"/></tooltip>
                    </Button>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="Sair" onAction="#sair" styleClass="botao-icone, botao-icone-texto, botao-sair"
                            accessibleText="Sair">
                        <graphic><FontIcon iconLiteral="fth-log-out"/></graphic>
                    </Button>
                </HBox>
            </VBox>
        </VBox>
    </left>
</BorderPane>
