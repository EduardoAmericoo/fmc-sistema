<?xml version="1.0" encoding="UTF-8"?>

<!--
  Importar planilha (revisão da SR2): trazer os dados da Fundação de uma vez.
  1. baixar o modelo; 2. preencher no Excel; 3. escolher a planilha: o sistema confere tudo
  (num ensaio, sem gravar) e só libera "Importar agora" quando não houver nenhum problema.
-->

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<StackPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
           fx:controller="br.org.fmc.ui.ImportarController">
    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="rolagem">
        <VBox styleClass="conteudo" spacing="20">
            <VBox spacing="6">
                <Label text="Importar planilha" styleClass="titulo"/>
                <Label text="Traga de uma vez os imóveis, inquilinos e contratos que a Fundação tem hoje no papel ou no Excel, em vez de cadastrar um por um."
                       styleClass="texto" wrapText="true" minHeight="-Infinity"/>
            </VBox>

            <GridPane hgap="16">
                <columnConstraints>
                    <ColumnConstraints percentWidth="33.3" hgrow="ALWAYS"/>
                    <ColumnConstraints percentWidth="33.3" hgrow="ALWAYS"/>
                    <ColumnConstraints percentWidth="33.3" hgrow="ALWAYS"/>
                </columnConstraints>
                <VBox styleClass="cartao-resumo, passo-importacao" spacing="10" maxWidth="Infinity" maxHeight="Infinity" GridPane.columnIndex="0">
                    <Label text="1. Baixe o modelo" styleClass="subtitulo"/>
                    <Label text="Uma planilha do Excel com as abas Imóveis, Inquilinos e Contratos, uma dica em cada coluna e listas de escolha."
                           styleClass="texto" wrapText="true" minHeight="-Infinity" VBox.vgrow="ALWAYS"/>
                    <Button text="Baixar modelo (.xlsx)" onAction="#baixarModelo" styleClass="botao-secundario" minWidth="-Infinity">
                        <graphic><FontIcon iconLiteral="fth-download"/></graphic>
                    </Button>
                </VBox>
                <VBox styleClass="cartao-resumo, passo-importacao" spacing="10" maxWidth="Infinity" maxHeight="Infinity" GridPane.columnIndex="1">
                    <Label text="2. Preencha no Excel" styleClass="subtitulo"/>
                    <Label text="Uma linha por cadastro, a partir da linha 4. A linha de exemplo é ignorada. Imóvel alugado fica Vago: o contrato o deixa ocupado. Veja a aba Como preencher."
                           styleClass="texto" wrapText="true" minHeight="-Infinity"/>
                </VBox>
                <VBox styleClass="cartao-resumo, passo-importacao" spacing="10" maxWidth="Infinity" maxHeight="Infinity" GridPane.columnIndex="2">
                    <Label text="3. Confira e importe" styleClass="subtitulo"/>
                    <Label text="O sistema confere cada linha com as mesmas regras das telas, sem gravar nada, e mostra o que corrigir."
                           styleClass="texto" wrapText="true" minHeight="-Infinity" VBox.vgrow="ALWAYS"/>
                    <Button fx:id="botaoEscolher" text="Escolher planilha…" onAction="#escolherPlanilha" styleClass="botao-primario" minWidth="-Infinity">
                        <graphic><FontIcon iconLiteral="fth-upload"/></graphic>
                    </Button>
                </VBox>
            </GridPane>

            <HBox fx:id="avisoOk" styleClass="veredito, veredito-ok" spacing="10" alignment="CENTER_LEFT">
                <FontIcon iconLiteral="fth-check-circle"/>
                <Label fx:id="textoOk" wrapText="true" minHeight="-Infinity" HBox.hgrow="ALWAYS"/>
            </HBox>

            <HBox fx:id="avisoErros" styleClass="aviso-erro" spacing="10">
                <FontIcon iconLiteral="fth-alert-circle"/>
                <Label fx:id="textoErros" wrapText="true" minHeight="-Infinity" HBox.hgrow="ALWAYS"/>
            </HBox>

            <VBox fx:id="blocoResultado" spacing="14">
                <HBox fx:id="veredito" styleClass="veredito" spacing="10" alignment="CENTER_LEFT">
                    <FontIcon fx:id="iconeVeredito" iconLiteral="fth-check-circle"/>
                    <Label fx:id="textoVeredito" wrapText="true" minHeight="-Infinity" HBox.hgrow="ALWAYS"/>
                </HBox>
                <HBox spacing="16">
                    <VBox styleClass="kpi" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                        <Label text="Imóveis" styleClass="kpi-rotulo"/><Label fx:id="qtdImoveis" styleClass="kpi-valor"/>
                    </VBox>
                    <VBox styleClass="kpi" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                        <Label text="Inquilinos" styleClass="kpi-rotulo"/><Label fx:id="qtdInquilinos" styleClass="kpi-valor"/>
                    </VBox>
                    <VBox styleClass="kpi" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                        <Label text="Contratos" styleClass="kpi-rotulo"/><Label fx:id="qtdContratos" styleClass="kpi-valor"/>
                    </VBox>
                    <VBox styleClass="kpi" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                        <Label text="Problemas" styleClass="kpi-rotulo"/><Label fx:id="qtdProblemas" styleClass="kpi-valor"/>
                    </VBox>
                </HBox>
                <VBox fx:id="cartaoProblemas" styleClass="cartao-tabela">
                    <TableView fx:id="tabelaProblemas" styleClass="tabela-fmc" prefHeight="320">
                        <columns>
                            <TableColumn fx:id="colunaOnde" text="Onde corrigir" prefWidth="200" minWidth="170"/>
                            <TableColumn fx:id="colunaProblema" text="O que corrigir" prefWidth="700" minWidth="300"/>
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
                        </columnResizePolicy>
                    </TableView>
                </VBox>
                <HBox spacing="12" alignment="CENTER_LEFT">
                    <Label fx:id="nomeArquivo" styleClass="texto" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="botaoConferirDeNovo" text="Conferir de novo" onAction="#conferirDeNovo"
                            styleClass="botao-secundario" minWidth="-Infinity">
                        <graphic><FontIcon iconLiteral="fth-refresh-cw"/></graphic>
                    </Button>
                    <Button fx:id="botaoImportar" text="Importar agora" onAction="#importar" styleClass="botao-primario"
                            minWidth="-Infinity">
                        <graphic><FontIcon iconLiteral="fth-check"/></graphic>
                    </Button>
                </HBox>
            </VBox>
        </VBox>
    </ScrollPane>
</StackPane>
