<?xml version="1.0" encoding="UTF-8"?>

<!--
  BOARD-53 · Tela "Usuários": lista de usuários e cadastro de usuário novo.
  BOARD-41 · Clicar num usuário da lista abre as permissões dele em caixinhas.
  Aberta pelo botão "Usuários" do menu (o nome do arquivo é o mesmo do userData do botão).
-->

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="br.org.fmc.ui.UsuariosController" styleClass="conteudo" spacing="16">

    <VBox spacing="4">
        <Label text="Usuários" styleClass="titulo"/>
        <Label text="O Administrador cria o acesso de cada pessoa da equipe e escolhe o perfil dela. Clique em um usuário da lista para ajustar as permissões dele."
               styleClass="texto" wrapText="true"/>
        <Label fx:id="aviso" styleClass="erro" wrapText="true" minHeight="-Infinity"/>
    </VBox>

    <HBox spacing="20" VBox.vgrow="ALWAYS">
        <TableView fx:id="tabela" HBox.hgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colunaNome" text="Nome" prefWidth="160"/>
                <TableColumn fx:id="colunaEmail" text="E-mail" prefWidth="200"/>
                <TableColumn fx:id="colunaPerfil" text="Perfil" prefWidth="110"/>
                <TableColumn fx:id="colunaPermissoes" text="Permissões" prefWidth="120"/>
                <TableColumn fx:id="colunaSituacao" text="Situação" prefWidth="90"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
            </columnResizePolicy>
        </TableView>

        <ScrollPane fx:id="ladoDireito" fitToWidth="true" prefWidth="340" minWidth="300"
                    hbarPolicy="NEVER" styleClass="rolagem">
            <VBox spacing="16">
                <!-- BOARD-41 · Aparece quando um usuário é escolhido na lista -->
                <VBox fx:id="cartaoPermissoes" styleClass="cartao-formulario" spacing="8">
                    <Label fx:id="tituloPermissoes" text="Permissões" styleClass="subtitulo" wrapText="true"
                           minHeight="-Infinity"/>
                    <Label fx:id="dicaPermissoes" styleClass="dica" wrapText="true" minHeight="-Infinity"/>
                    <VBox fx:id="caixasPermissoes" spacing="6"/>
                    <Label fx:id="mensagemPermissoes" wrapText="true" minHeight="-Infinity"/>
                    <Button text="Salvar permissões" onAction="#salvarPermissoes" styleClass="botao-primario"
                            maxWidth="Infinity"/>
                    <Button text="Voltar ao padrão do perfil" onAction="#restaurarPermissoes"
                            styleClass="botao-secundario" maxWidth="Infinity"/>
                    <Button text="Fechar" onAction="#fecharPermissoes" styleClass="botao-secundario"
                            maxWidth="Infinity"/>
                </VBox>

                <VBox fx:id="formulario" styleClass="cartao-formulario" spacing="8">
                    <Label text="Novo usuário" styleClass="subtitulo"/>

                    <Label text="Nome" labelFor="$campoNome" styleClass="rotulo"/>
                    <TextField fx:id="campoNome" styleClass="campo"/>

                    <Label text="E-mail" labelFor="$campoEmail" styleClass="rotulo"/>
                    <TextField fx:id="campoEmail" promptText="nome@exemplo.org" styleClass="campo"/>

                    <Label text="Perfil" labelFor="$campoPerfil" styleClass="rotulo"/>
                    <ComboBox fx:id="campoPerfil" maxWidth="Infinity" styleClass="campo"/>

                    <Label text="Senha inicial" labelFor="$campoSenha" styleClass="rotulo"/>
                    <PasswordField fx:id="campoSenha" styleClass="campo"/>
                    <Label text="Mínimo de 6 caracteres. Entregue a senha à pessoa." styleClass="dica" wrapText="true"
                           minHeight="-Infinity"/>

                    <!-- minHeight="-Infinity" deixa o texto quebrar em várias linhas em vez de cortar com "..." -->
                    <Label fx:id="mensagem" wrapText="true" minHeight="-Infinity"/>

                    <Button text="Criar usuário" onAction="#criar" styleClass="botao-primario" maxWidth="Infinity"/>
                </VBox>
            </VBox>
        </ScrollPane>
    </HBox>
</VBox>
