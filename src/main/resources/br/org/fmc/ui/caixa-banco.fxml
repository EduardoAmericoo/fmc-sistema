<?xml version="1.0" encoding="UTF-8"?>

<!--
  [D5] BOARD-63 · Caixa e banco, no desenho do protótipo:
  1. Disponibilidades: quanto há hoje no Caixa e no Banco, com a barra e o total;
  2. abas Movimento do Caixa e Movimento do Banco, com o mês;
  3. saldo anterior, entradas, saídas e saldo final do mês;
  4. a lista de lançamentos do mês, com o saldo depois de cada um.
  O saldo inicial é informado uma vez pelo Administrador (janela saldo-inicial.fxml).
-->

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<StackPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
           fx:controller="br.org.fmc.ui.CaixaBancoController">
    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="rolagem">
        <VBox styleClass="conteudo" spacing="20">
            <HBox alignment="BOTTOM_LEFT" spacing="24">
                <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <Label text="Caixa e banco" styleClass="titulo"/>
                    <Label text="Movimento gerado pelos recibos, sem copiar entre planilhas." styleClass="texto"/>
                </VBox>
                <Button fx:id="botaoDepositar" text="Depositar ou sacar" onAction="#depositarNoBanco"
                        styleClass="botao-secundario" minWidth="-Infinity">
                    <graphic><FontIcon iconLiteral="fth-arrow-right-circle"/></graphic>
                </Button>
                <Button fx:id="botaoSaldoInicial" text="Informar saldo inicial" onAction="#informarSaldoInicial"
                        styleClass="botao-primario" minWidth="-Infinity">
                    <graphic><FontIcon iconLiteral="fth-edit-3"/></graphic>
                </Button>
            </HBox>

            <HBox fx:id="avisoSaldoInicial" styleClass="veredito, veredito-alerta" spacing="10" alignment="CENTER_LEFT">
                <FontIcon iconLiteral="fth-alert-triangle"/>
                <Label fx:id="textoAvisoSaldo" wrapText="true" minHeight="-Infinity" HBox.hgrow="ALWAYS"/>
            </HBox>

            <HBox spacing="16">
                <VBox styleClass="cartao-resumo" spacing="12" HBox.hgrow="ALWAYS">
                    <HBox alignment="CENTER_LEFT">
                        <Label text="Disponibilidades" styleClass="subtitulo" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                        <Label fx:id="dataDisponibilidades" styleClass="texto"/>
                    </HBox>
                    <HBox fx:id="barra" styleClass="barra-situacoes" spacing="4">
                        <Region fx:id="barraCaixa" styleClass="barra-caixa"/>
                        <Region fx:id="barraBanco" styleClass="barra-banco"/>
                    </HBox>
                    <HBox spacing="28">
                        <VBox spacing="2"><Label text="Caixa" styleClass="legenda-caixa"/><Label fx:id="percentualCaixa" styleClass="numero-resumo"/></VBox>
                        <VBox spacing="2"><Label text="Banco" styleClass="legenda-banco"/><Label fx:id="percentualBanco" styleClass="numero-resumo"/></VBox>
                    </HBox>
                    <VBox>
                        <HBox styleClass="linha-detalhe"><Label text="1. Caixa (dinheiro e cheque)"/><Region HBox.hgrow="ALWAYS"/><Label fx:id="saldoCaixa" styleClass="valor-forte"/></HBox>
                        <HBox styleClass="linha-detalhe"><Label text="2. Banco (PIX, transferência e boleto)"/><Region HBox.hgrow="ALWAYS"/><Label fx:id="saldoBanco" styleClass="valor-forte"/></HBox>
                        <HBox styleClass="linha-total"><Label text="Total geral"/><Region HBox.hgrow="ALWAYS"/><Label fx:id="saldoTotal"/></HBox>
                    </VBox>
                </VBox>
                <VBox styleClass="resumo-calculado" spacing="8" prefWidth="320" minWidth="260" maxWidth="340"
                      maxHeight="-Infinity">
                    <Label text="Regra do processo financeiro" styleClass="rotulo"/>
                    <Label wrapText="true" minHeight="-Infinity"
                           text="Pagamento em dinheiro ou cheque entra no Caixa. PIX, transferência e boleto entram no Banco. Cada recibo lança o valor sozinho, na data do pagamento. Dinheiro levado ao banco ou sacado para o caixa: use &quot;Depositar ou sacar&quot;."/>
                    <Label fx:id="textoSaldoInicial" wrapText="true" minHeight="-Infinity"/>
                </VBox>
            </HBox>

            <HBox styleClass="abas" spacing="4">
                <fx:define><ToggleGroup fx:id="grupoConta"/></fx:define>
                <ToggleButton fx:id="abaCaixa" text="Movimento do Caixa" toggleGroup="$grupoConta" styleClass="aba"/>
                <ToggleButton fx:id="abaBanco" text="Movimento do Banco" toggleGroup="$grupoConta" styleClass="aba"/>
            </HBox>

            <HBox spacing="12" alignment="CENTER_LEFT">
                <HBox styleClass="seletor-mes" alignment="CENTER">
                    <Button fx:id="mesAnterior" onAction="#irMesAnterior" styleClass="seta-mes" accessibleText="Mês anterior">
                        <graphic><FontIcon iconLiteral="fth-chevron-left"/></graphic>
                    </Button>
                    <ComboBox fx:id="campoMes" prefWidth="215" styleClass="nome-mes" accessibleText="Mês do movimento"/>
                    <Button fx:id="mesSeguinte" onAction="#irMesSeguinte" styleClass="seta-mes" accessibleText="Mês seguinte">
                        <graphic><FontIcon iconLiteral="fth-chevron-right"/></graphic>
                    </Button>
                </HBox>
                <Label fx:id="descricaoConta" styleClass="texto"/>
            </HBox>

            <HBox fx:id="cartoesMes" spacing="16"/>

            <VBox styleClass="cartao-tabela">
                <TableView fx:id="tabela" styleClass="tabela-fmc" prefHeight="380">
                    <columns>
                        <TableColumn fx:id="colunaData" text="Data" prefWidth="110" minWidth="100"/>
                        <TableColumn fx:id="colunaDescricao" text="Lançamento" prefWidth="460" minWidth="260"/>
                        <TableColumn fx:id="colunaEntrada" text="Entrada" prefWidth="140" minWidth="120" styleClass="coluna-numero"/>
                        <TableColumn fx:id="colunaSaida" text="Saída" prefWidth="140" minWidth="120" styleClass="coluna-numero"/>
                        <TableColumn fx:id="colunaSaldo" text="Saldo" prefWidth="150" minWidth="130" styleClass="coluna-numero"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
                    </columnResizePolicy>
                </TableView>
            </VBox>
        </VBox>
    </ScrollPane>
</StackPane>
