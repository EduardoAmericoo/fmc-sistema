<?xml version="1.0" encoding="UTF-8"?>

<!--
  BOARD-35 · Tela "Inquilinos", no visual do design system da Fundação.

  Três camadas empilhadas (StackPane), de baixo para cima:
  1. a página: cabeçalho (título + botão "Novo inquilino"), a busca (como na tela de Imóveis) e a tabela num cartão;
  2. o aviso rápido (toast) no canto de baixo, depois de salvar;
  3. o véu escuro com a janela do formulário, que só aparece ao criar ou editar.
-->

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<StackPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
           fx:controller="br.org.fmc.ui.InquilinosController">

    <!-- 1. Página -->
    <VBox styleClass="conteudo" spacing="24">
        <HBox alignment="BOTTOM_LEFT" spacing="24">
            <VBox spacing="6" HBox.hgrow="ALWAYS">
                <Label text="Inquilinos" styleClass="titulo"/>
                <Label fx:id="contagem" styleClass="texto"/>
            </VBox>
            <Button fx:id="botaoNovo" text="Novo inquilino" onAction="#novo" styleClass="botao-primario">
                <graphic><FontIcon iconLiteral="fth-plus"/></graphic>
            </Button>
        </HBox>

        <!-- BOARD-56 · Busca por nome ou CPF, no mesmo lugar e formato da busca da tela de Imóveis:
             filtra a lista enquanto a pessoa digita -->
        <HBox spacing="12" alignment="CENTER_LEFT">
            <TextField fx:id="campoBusca" promptText="Buscar por nome ou CPF" HBox.hgrow="ALWAYS"
                       accessibleText="Buscar inquilino por nome ou CPF"/>
            <Button text="Limpar busca" onAction="#limparBusca"/>
        </HBox>

        <VBox styleClass="cartao-tabela" VBox.vgrow="ALWAYS">
            <TableView fx:id="tabela" styleClass="tabela-fmc" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colunaNome" text="Inquilino" prefWidth="300"/>
                    <TableColumn fx:id="colunaCpf" text="CPF" prefWidth="140"/>
                    <TableColumn fx:id="colunaTelefone" text="Telefone" prefWidth="150"/>
                    <TableColumn fx:id="colunaEstadoCivil" text="Estado civil" prefWidth="140"/>
                    <TableColumn fx:id="colunaRenda" text="Renda familiar" prefWidth="150" styleClass="coluna-numero"/>
                    <TableColumn fx:id="colunaAcoes" prefWidth="56" maxWidth="56" minWidth="56" sortable="false"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
                </columnResizePolicy>
            </TableView>
        </VBox>
    </VBox>

    <!-- 2. Aviso rápido depois de salvar -->
    <HBox fx:id="toast" styleClass="toast" spacing="10" alignment="CENTER_LEFT"
          StackPane.alignment="BOTTOM_RIGHT" maxWidth="-Infinity" maxHeight="-Infinity">
        <StackPane.margin><Insets right="32" bottom="28"/></StackPane.margin>
        <FontIcon iconLiteral="fth-check-circle"/>
        <Label fx:id="textoToast"/>
    </HBox>

    <!-- 3. Janela do formulário, sobre um véu escuro -->
    <StackPane fx:id="veu" styleClass="veu">
        <VBox fx:id="janela" styleClass="janela" maxWidth="720" maxHeight="-Infinity">
            <StackPane.margin><Insets top="32" right="32" bottom="32" left="32"/></StackPane.margin>

            <HBox styleClass="janela-topo" spacing="16" alignment="TOP_LEFT">
                <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <Label fx:id="tituloJanela" text="Novo inquilino" styleClass="janela-titulo"/>
                    <Label text="Dados da proposta de locação. Campos com * são obrigatórios." styleClass="janela-sub"
                           wrapText="true"/>
                </VBox>
                <Button onAction="#fechar" styleClass="botao-icone" accessibleText="Fechar">
                    <graphic><FontIcon iconLiteral="fth-x"/></graphic>
                </Button>
            </HBox>

            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="rolagem" VBox.vgrow="ALWAYS">
                <VBox styleClass="janela-corpo" spacing="20">

                    <HBox fx:id="avisoErros" styleClass="aviso-erro" spacing="10">
                        <FontIcon iconLiteral="fth-alert-circle"/>
                        <Label fx:id="textoErros" wrapText="true" minHeight="-Infinity" HBox.hgrow="ALWAYS"/>
                    </HBox>

                    <Label text="Dados pessoais" styleClass="secao-formulario"/>
                    <GridPane hgap="16" vgap="14">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="50"/>
                            <ColumnConstraints percentWidth="50"/>
                        </columnConstraints>
                        <VBox spacing="6" GridPane.columnSpan="2">
                            <Label text="Nome completo *" labelFor="$campoNome" styleClass="rotulo"/>
                            <TextField fx:id="campoNome" styleClass="campo"/>
                        </VBox>
                        <VBox spacing="6" GridPane.rowIndex="1">
                            <Label text="CPF *" labelFor="$campoCpf" styleClass="rotulo"/>
                            <TextField fx:id="campoCpf" promptText="Só os números" styleClass="campo"/>
                            <Label fx:id="dicaCpf" wrapText="true" minHeight="-Infinity"/>
                        </VBox>
                        <VBox spacing="6" GridPane.rowIndex="1" GridPane.columnIndex="1">
                            <Label text="Estado civil *" labelFor="$campoEstadoCivil" styleClass="rotulo"/>
                            <ComboBox fx:id="campoEstadoCivil" maxWidth="Infinity" styleClass="campo"/>
                        </VBox>
                        <VBox spacing="6" GridPane.rowIndex="2">
                            <Label text="Telefone" labelFor="$campoTelefone" styleClass="rotulo"/>
                            <TextField fx:id="campoTelefone" promptText="DDD e número" styleClass="campo"/>
                        </VBox>
                        <VBox spacing="6" GridPane.rowIndex="2" GridPane.columnIndex="1">
                            <Label text="E-mail" labelFor="$campoEmail" styleClass="rotulo"/>
                            <TextField fx:id="campoEmail" promptText="nome@exemplo.org" styleClass="campo"/>
                        </VBox>
                    </GridPane>

                    <Label text="Trabalho e renda" styleClass="secao-formulario"/>
                    <GridPane hgap="16" vgap="14">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="50"/>
                            <ColumnConstraints percentWidth="50"/>
                        </columnConstraints>
                        <VBox spacing="6">
                            <Label text="Profissão" labelFor="$campoProfissao" styleClass="rotulo"/>
                            <TextField fx:id="campoProfissao" styleClass="campo"/>
                        </VBox>
                        <VBox spacing="6" GridPane.columnIndex="1">
                            <Label text="Local de trabalho" labelFor="$campoLocalTrabalho" styleClass="rotulo"/>
                            <TextField fx:id="campoLocalTrabalho" styleClass="campo"/>
                        </VBox>
                        <VBox spacing="6" GridPane.rowIndex="1">
                            <Label text="Renda mensal (R$)" labelFor="$campoRenda" styleClass="rotulo"/>
                            <TextField fx:id="campoRenda" promptText="2.500,00" styleClass="campo"/>
                        </VBox>
                        <VBox spacing="6" GridPane.rowIndex="1" GridPane.columnIndex="1">
                            <Label text="Outras rendas (R$)" labelFor="$campoOutrasRendas" styleClass="rotulo"/>
                            <TextField fx:id="campoOutrasRendas" promptText="0,00" styleClass="campo"/>
                        </VBox>
                    </GridPane>

                    <VBox fx:id="blocoConjuge" spacing="14">
                        <VBox spacing="4">
                            <Label text="Cônjuge" styleClass="secao-formulario"/>
                            <Label text="A renda do cônjuge entra na renda familiar." styleClass="dica"/>
                        </VBox>
                        <GridPane hgap="16" vgap="14">
                            <columnConstraints>
                                <ColumnConstraints percentWidth="50"/>
                                <ColumnConstraints percentWidth="50"/>
                            </columnConstraints>
                            <VBox spacing="6" GridPane.columnSpan="2">
                                <Label text="Nome do cônjuge" labelFor="$campoConjugeNome" styleClass="rotulo"/>
                                <TextField fx:id="campoConjugeNome" styleClass="campo"/>
                            </VBox>
                            <VBox spacing="6" GridPane.rowIndex="1">
                                <Label text="CPF do cônjuge" labelFor="$campoConjugeCpf" styleClass="rotulo"/>
                                <TextField fx:id="campoConjugeCpf" promptText="Só os números" styleClass="campo"/>
                                <Label fx:id="dicaConjugeCpf" wrapText="true" minHeight="-Infinity"/>
                            </VBox>
                            <VBox spacing="6" GridPane.rowIndex="1" GridPane.columnIndex="1">
                                <Label text="Renda do cônjuge (R$)" labelFor="$campoConjugeRenda" styleClass="rotulo"/>
                                <TextField fx:id="campoConjugeRenda" promptText="0,00" styleClass="campo"/>
                            </VBox>
                        </GridPane>
                    </VBox>
                </VBox>
            </ScrollPane>

            <HBox styleClass="janela-rodape" spacing="12" alignment="CENTER_RIGHT">
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Cancelar" onAction="#fechar" styleClass="botao-secundario"/>
                <Button fx:id="botaoSalvar" text="Cadastrar inquilino" onAction="#salvar" styleClass="botao-primario"
                        defaultButton="true"/>
            </HBox>
        </VBox>
    </StackPane>
</StackPane>
